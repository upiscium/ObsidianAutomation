{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/upiscium/ObsidianAutomation/schemas/create-note-v0.schema.json",
  "title": "Obsidian create_note canonical mutation v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation",
    "mutation_id",
    "target",
    "content"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "operation": {
      "const": "create_note"
    },
    "mutation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1024,
          "pattern": "\\.md$"
        }
      }
    },
    "content": {
      "type": "string",
      "minLength": 1
    }
  }
}
