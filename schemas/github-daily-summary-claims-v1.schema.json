{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "github-daily-summary-claims-v1.schema.json",
  "title": "GitHub Daily Summary Claims v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "repository", "summary", "evidence_ids"],
        "properties": {
          "kind": {
            "enum": [
              "decision",
              "implementation",
              "bugfix",
              "issue_pr_progress"
            ]
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
