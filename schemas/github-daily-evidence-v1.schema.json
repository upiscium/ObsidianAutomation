{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "github-daily-evidence-v1.schema.json",
  "title": "GitHub Daily Project Activity Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "date",
    "timezone",
    "window_start",
    "window_end",
    "projects",
    "repositories",
    "events"
  ],
  "properties": {
    "record_version": {"const": 1},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "timezone": {"const": "Asia/Tokyo"},
    "window_start": {"$ref": "#/$defs/timestamp"},
    "window_end": {"$ref": "#/$defs/timestamp"},
    "projects": {
      "type": "array",
      "items": {"$ref": "#/$defs/project"}
    },
    "repositories": {
      "type": "array",
      "items": {"$ref": "#/$defs/repository"}
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "excerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "truncated",
        "original_bytes",
        "included_bytes"
      ],
      "properties": {
        "text": {"type": "string"},
        "truncated": {"type": "boolean"},
        "original_bytes": {"type": "integer", "minimum": 0},
        "included_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_path", "repository"],
      "properties": {
        "project_path": {
          "type": "string",
          "pattern": "^10-Project/.+\\.md$"
        },
        "repository": {"$ref": "#/$defs/repository"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "repository",
        "occurred_at",
        "url",
        "actor",
        "entity_type",
        "number",
        "source_id",
        "sha",
        "state",
        "draft",
        "title",
        "body",
        "message"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/sha256"},
        "kind": {
          "enum": [
            "issue_created",
            "issue_snapshot",
            "issue_closed",
            "issue_reopened",
            "issue_comment",
            "pull_request_created",
            "pull_request_snapshot",
            "pull_request_closed",
            "pull_request_reopened",
            "pull_request_merged",
            "pull_request_ready_for_review",
            "pull_request_converted_to_draft",
            "pull_request_comment",
            "pull_request_review",
            "pull_request_review_comment",
            "pull_request_commit",
            "default_branch_commit"
          ]
        },
        "repository": {"$ref": "#/$defs/repository"},
        "occurred_at": {"$ref": "#/$defs/timestamp"},
        "url": {"type": "string", "minLength": 1},
        "actor": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "entity_type": {
          "enum": [
            "issue",
            "issue_comment",
            "pull_request",
            "pull_request_comment",
            "pull_request_review",
            "pull_request_review_comment",
            "commit"
          ]
        },
        "number": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{7,64}$"
            }
          ]
        },
        "state": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "draft": {
          "type": ["boolean", "null"]
        },
        "title": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/excerpt"}
          ]
        },
        "body": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/excerpt"}
          ]
        },
        "message": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/excerpt"}
          ]
        }
      }
    }
  }
}
