{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-bundle-v0.schema.json",
  "title": "Knowledge Context Bundle v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "query", "created_at", "sources"],
  "properties": {
    "record_version": {"const": 1},
    "query": {"type": "string", "minLength": 1, "maxLength": 4096},
    "created_at": {"type": "string", "pattern": "Z$"},
    "sources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_sha256", "content"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^11-Knowledge/.+\\.md$",
            "maxLength": 1024
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content": {"type": "string"}
        }
      }
    }
  }
}
