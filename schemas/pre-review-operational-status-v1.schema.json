{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pre-review-operational-status-v1.schema.json",
  "title": "Pre-review operational status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "authority",
    "generated_at",
    "pipeline_health",
    "reasons",
    "current_jobs",
    "states",
    "review_wait",
    "backpressure",
    "planner_cadence"
  ],
  "properties": {
    "record_version": {
      "const": 2
    },
    "authority": {
      "const": "orchestration_status_projection_only"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "pipeline_health": {
      "enum": ["OK", "WARNING", "CRITICAL"]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "current_jobs": {
      "type": "integer",
      "minimum": 0
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queued",
        "generating",
        "validating",
        "building_evaluation_context",
        "evaluating",
        "awaiting_human_review",
        "approved_pending_execution",
        "human_rejected",
        "human_kept_as_idea",
        "completed",
        "retryable_failure",
        "retry_exhausted",
        "blocked",
        "deterministic_reject",
        "superseded"
      ],
      "properties": {
        "queued": {"type": "integer", "minimum": 0},
        "generating": {"type": "integer", "minimum": 0},
        "validating": {"type": "integer", "minimum": 0},
        "building_evaluation_context": {"type": "integer", "minimum": 0},
        "evaluating": {"type": "integer", "minimum": 0},
        "awaiting_human_review": {"type": "integer", "minimum": 0},
        "approved_pending_execution": {"type": "integer", "minimum": 0},
        "human_rejected": {"type": "integer", "minimum": 0},
        "human_kept_as_idea": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "retryable_failure": {"type": "integer", "minimum": 0},
        "retry_exhausted": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "deterministic_reject": {"type": "integer", "minimum": 0},
        "superseded": {"type": "integer", "minimum": 0}
      }
    },
    "review_wait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "oldest_age_seconds",
        "reminder_after_seconds",
        "reminder_due"
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "oldest_age_seconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "reminder_after_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "reminder_due": {"type": "boolean"}
      }
    },
    "backpressure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "active"],
      "properties": {
        "threshold": {"type": "integer", "minimum": 1},
        "active": {"type": "boolean"}
      }
    },
    "planner_cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "interval_seconds",
        "reason",
        "awaiting_human_review",
        "last_submission_at",
        "next_eligible_at",
        "last_selection_policy",
        "last_objective_policy",
        "last_novelty_skip_at",
        "last_novelty_skip_reason"
      ],
      "properties": {
        "eligible": {"type": "boolean"},
        "interval_seconds": {
          "type": "integer",
          "minimum": 900
        },
        "reason": {
          "enum": [
            "first_submission_ready",
            "normal_interval",
            "human_review_backlog_1",
            "human_review_backlog_2_plus",
            "legacy_status_no_cadence"
          ]
        },
        "awaiting_human_review": {
          "type": "integer",
          "minimum": 0
        },
        "last_submission_at": {
          "type": ["string", "null"]
        },
        "next_eligible_at": {
          "type": "string",
          "minLength": 1
        },
        "last_selection_policy": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "last_objective_policy": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "last_novelty_skip_at": {
          "type": ["string", "null"]
        },
        "last_novelty_skip_reason": {
          "type": ["string", "null"],
          "maxLength": 512
        }
      }
    }
  }
}
