{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pre-review-recipe-v0.schema.json",
  "title": "Knowledge pre-review recipe v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "pipeline",
    "generator",
    "validator",
    "evaluation_context",
    "evaluator"
  ],
  "properties": {
    "record_version": {"const": 1},
    "pipeline": {"const": "knowledge-pre-review-v0"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_revision",
        "prompt_template_version",
        "prompt_template_sha256",
        "provider",
        "model_identifier",
        "model_revision",
        "model_config"
      ],
      "properties": {
        "implementation_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "prompt_template_version": {"const": "knowledge-note-generator-v0"},
        "prompt_template_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider": {"const": "openai-compatible"},
        "model_identifier": {"type": "string", "minLength": 1, "maxLength": 512},
        "model_revision": {"type": "string", "pattern": "^identifier:.{1,500}$"},
        "model_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter_version", "identity_binding", "options"],
          "properties": {
            "adapter_version": {"const": "openai-chat-completions-json-v0"},
            "identity_binding": {"const": "identifier-only"},
            "options": {"type": "object"}
          }
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {"const": "knowledge-note-v0"}
      }
    },
    "evaluation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_policy", "top_k"],
      "properties": {
        "selection_policy": {"const": "bm25-topk-recall-v0"},
        "top_k": {"const": 5}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_revision",
        "prompt_template_version",
        "prompt_template_sha256",
        "provider",
        "model_identifier",
        "model_revision",
        "model_config"
      ],
      "properties": {
        "implementation_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "prompt_template_version": {"const": "knowledge-note-evaluator-v3"},
        "prompt_template_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider": {"const": "ollama"},
        "model_identifier": {"type": "string", "minLength": 1, "maxLength": 512},
        "model_revision": {"type": "string", "minLength": 1, "maxLength": 512},
        "model_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter_version", "identity_binding", "strategy", "options"],
          "properties": {
            "adapter_version": {"const": "openai-evaluator-chat-completions-json-v0"},
            "identity_binding": {"const": "identifier-only"},
            "strategy": {"const": "groundedness-plus-pairwise-candidates-v0"},
            "options": {"type": "object"}
          }
        }
      }
    }
  }
}
