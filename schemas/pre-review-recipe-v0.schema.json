{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pre-review-recipe-v0.schema.json",
  "title": "Knowledge pre-review recipe v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "pipeline",
    "generator",
    "validator",
    "evaluation_context",
    "evaluator"
  ],
  "properties": {
    "record_version": {"const": 1},
    "pipeline": {"const": "knowledge-pre-review-v0"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_revision",
        "prompt_template_version",
        "prompt_template_sha256",
        "provider",
        "model_identifier",
        "model_revision",
        "model_config"
      ],
      "properties": {
        "implementation_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "prompt_template_version": {
          "enum": [
            "knowledge-note-generator-v0",
            "knowledge-note-generator-v1"
          ]
        },
        "prompt_template_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider": {"const": "openai-compatible"},
        "model_identifier": {"type": "string", "minLength": 1, "maxLength": 512},
        "model_revision": {"type": "string", "pattern": "^identifier:.{1,500}$"},
        "model_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter_version", "identity_binding", "options"],
          "properties": {
            "adapter_version": {"const": "openai-chat-completions-json-schema-v1"},
            "identity_binding": {"const": "identifier-only"},
            "options": {"type": "object"}
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "prompt_template_version": {"const": "knowledge-note-generator-v0"},
            "prompt_template_sha256": {
              "const": "820f86bf9f7e5495be64608690123ec31562441d4d774095d5d61ba7db9abafd"
            }
          }
        },
        {
          "properties": {
            "prompt_template_version": {"const": "knowledge-note-generator-v1"},
            "prompt_template_sha256": {
              "const": "ebdcbfdc5008a1c84366555debc15842e154cfaf51919d023c30d3d5c3fa9248"
            }
          }
        }
      ]
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {"const": "knowledge-note-v0"}
      }
    },
    "evaluation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_policy", "top_k"],
      "properties": {
        "selection_policy": {"const": "bm25-topk-recall-v0"},
        "top_k": {"const": 5}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_revision",
        "prompt_template_version",
        "prompt_template_sha256",
        "provider",
        "model_identifier",
        "model_revision",
        "model_config"
      ],
      "properties": {
        "implementation_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "prompt_template_version": {
          "enum": [
            "knowledge-note-evaluator-v3",
            "knowledge-note-evaluator-v4"
          ]
        },
        "prompt_template_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider": {"const": "openai-compatible"},
        "model_identifier": {"type": "string", "minLength": 1, "maxLength": 512},
        "model_revision": {"type": "string", "pattern": "^identifier:.{1,500}$"},
        "model_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter_version", "identity_binding", "strategy", "options"],
          "properties": {
            "adapter_version": {"const": "openai-evaluator-chat-completions-json-schema-v1"},
            "identity_binding": {"const": "identifier-only"},
            "strategy": {"const": "groundedness-plus-pairwise-candidates-v0"},
            "options": {"type": "object"}
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "prompt_template_version": {"const": "knowledge-note-evaluator-v3"},
            "prompt_template_sha256": {
              "const": "bf6265294a4b346f12d1951f594760c80221380ccee9993c6ab866b6b1eca937"
            }
          }
        },
        {
          "properties": {
            "prompt_template_version": {"const": "knowledge-note-evaluator-v4"},
            "prompt_template_sha256": {
              "const": "9411d74c10cd8c3450be6b79f12c644433862a4b292a26db7444d32606ddea3b"
            }
          }
        }
      ]
    }
  }
}
