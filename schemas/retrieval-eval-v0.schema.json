{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upiscium.github.io/ObsidianAutomation/schemas/retrieval-eval-v0.schema.json",
  "title": "Retrieval Evaluation Set v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["eval_version", "name", "cases"],
  "properties": {
    "eval_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "query", "relevant_paths"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "query": {"type": "string", "minLength": 1, "maxLength": 4096},
          "relevant_paths": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^11-Knowledge/.+\\.md$"
            }
          }
        }
      }
    }
  }
}
