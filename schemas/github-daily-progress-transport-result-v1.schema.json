{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "github-daily-progress-transport-result-v1.schema.json",
  "title": "GitHub Daily Project Progress Transport Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "stage",
    "projection_sha256",
    "date",
    "target_path",
    "evidence_bundle_sha256",
    "grounded_summary_sha256",
    "section_body_sha256",
    "outcome",
    "before_content_sha256",
    "after_content_sha256",
    "completed_at"
  ],
  "properties": {
    "record_version": {"const": 1},
    "stage": {"const": "github_daily_progress_transport"},
    "projection_sha256": {"$ref": "#/$defs/sha256"},
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "target_path": {
      "type": "string",
      "pattern": "^00-DailyNote/[0-9]{4}/[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.md$"
    },
    "evidence_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "grounded_summary_sha256": {"$ref": "#/$defs/sha256"},
    "section_body_sha256": {"$ref": "#/$defs/sha256"},
    "outcome": {
      "enum": ["applied", "recovered", "already_desired"]
    },
    "before_content_sha256": {"$ref": "#/$defs/sha256"},
    "after_content_sha256": {"$ref": "#/$defs/sha256"},
    "completed_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
