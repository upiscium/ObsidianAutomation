[Unit]
Description=Publish bounded human-facing Obsidian AI projections
Requires=obsidian-pre-review-evaluator.service
After=network-online.target obsidian-pre-review-evaluator.service
Wants=network-online.target
ConditionPathExists=/etc/obsidian-ai/human-projection.env
ConditionPathExists=/etc/obsidian-ai/webdav-password

[Service]
Type=oneshot
User=obsidian-ai-sync
Group=obsidian-ai-sync
EnvironmentFile=/etc/obsidian-ai/human-projection.env
ExecStart=/opt/obsidian-ai/venv/bin/obsidian-ai-human-projection-sync \
  --ai-root /var/lib/obsidian-ai/state \
  --base-url ${NEXTCLOUD_BASE_URL} \
  --username ${NEXTCLOUD_USERNAME} \
  --password-file /etc/obsidian-ai/webdav-password
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/obsidian-ai /var/lib/obsidian-ai/state/16-Human-Projection
ReadWritePaths=/var/lib/obsidian-ai/state/17-Human-Projection-Result /var/lib/obsidian-ai/state/24-Locks
UMask=0027
TimeoutStartSec=5min
