# Non-secret binding for the dedicated rejected-projection cleanup account.
# Share only the existing 03-AI folder to this account with Read + Delete
# permissions (Nextcloud permission bitmask 9). The share must be mounted as
# 03-AI under the account root because cleanup targets are fixed below 03-AI/**.
# The app password remains in /etc/obsidian-ai/projection-cleanup-password.
PROJECTION_CLEANUP_BASE_URL=https://nextcloud.example/remote.php/dav/files/obsidian-ai-projection-cleanup
PROJECTION_CLEANUP_USERNAME=obsidian-ai-projection-cleanup
