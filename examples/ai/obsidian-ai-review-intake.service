[Unit]
Description=Consume Human Review decisions from private Obsidian AI projections
Requires=obsidian-ai-human-projection-sync.service
After=network-online.target obsidian-ai-human-projection-sync.service
Wants=network-online.target
ConditionPathExists=/etc/obsidian-ai/review-intake.env
ConditionPathExists=/etc/obsidian-ai/review-intake-password

[Service]
Type=oneshot
User=obsidian-ai-reviewer
Group=obsidian-ai-reviewer
EnvironmentFile=/etc/obsidian-ai/review-intake.env
ExecStart=/opt/obsidian-ai/venv/bin/obsidian-ai-review-intake \
  --ai-root /var/lib/obsidian-ai/state \
  --base-url ${REVIEW_NEXTCLOUD_BASE_URL} \
  --username ${REVIEW_NEXTCLOUD_USERNAME} \
  --password-file /etc/obsidian-ai/review-intake-password \
  --approver ${AI_REVIEW_APPROVER}
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/obsidian-ai /var/lib/obsidian-ai/state/10-Validation /var/lib/obsidian-ai/state/15-Evaluation /var/lib/obsidian-ai/state/16-Human-Projection/evaluator /var/lib/obsidian-ai/state/17-Human-Projection-Result
ReadWritePaths=/var/lib/obsidian-ai/state/20-Review
UMask=0027
TimeoutStartSec=2min
