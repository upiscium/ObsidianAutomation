# Automatic Semantic Index refresh is opt-in.
# Installing this file as /etc/obsidian-ai/semantic-index-refresh.env causes
# successful Vault mirror pulls to start the Reader -> Embedder -> Reader chain.
#
# Keep the endpoint local or HTTPS according to the existing Ollama transport
# policy. The embedding model identifier and exact digest are inherited from
# the active finalized Semantic Index and cannot be overridden here.
SEMANTIC_EMBEDDING_BASE_URL=http://127.0.0.1:11434
