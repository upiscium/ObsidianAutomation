# Non-secret provider/model binding for automatic Vault input planning.
# Provider endpoint and credentials remain in the existing role-owned env files.
#
# OpenAI-compatible example:
# AI_INPUT_GENERATOR_PROVIDER=openai-compatible
# AI_INPUT_GENERATOR_MODEL=gemma4:12b
# AI_INPUT_GENERATOR_MODEL_REVISION=auto
# AI_INPUT_EVALUATOR_PROVIDER=openai-compatible
# AI_INPUT_EVALUATOR_MODEL=gemma4:12b
# AI_INPUT_EVALUATOR_MODEL_REVISION=auto
#
# Ollama native production example:
AI_INPUT_GENERATOR_PROVIDER=ollama
AI_INPUT_GENERATOR_MODEL=gemma4:12b
AI_INPUT_GENERATOR_MODEL_REVISION=<64-hex-model-digest>
AI_INPUT_EVALUATOR_PROVIDER=ollama
AI_INPUT_EVALUATOR_MODEL=gemma4:12b
AI_INPUT_EVALUATOR_MODEL_REVISION=<64-hex-model-digest>
