# Non-secret binding for the read-only Nextcloud account used by Review Intake.
# The password/app password remains in /etc/obsidian-ai/review-intake-password.
# This account must have read-only access to the private Obsidian Vault.
REVIEW_NEXTCLOUD_BASE_URL=https://nextcloud.example/remote.php/dav/files/obsidian-ai-review-reader/ObsidianVault
REVIEW_NEXTCLOUD_USERNAME=obsidian-ai-review-reader
AI_REVIEW_APPROVER=human
