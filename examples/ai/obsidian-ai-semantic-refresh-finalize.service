[Unit]
Description=Finalize and activate automatic Obsidian Semantic Index refresh
Requires=obsidian-ai-semantic-refresh-embed.service
After=obsidian-ai-semantic-refresh-embed.service
ConditionPathExists=/etc/obsidian-ai/semantic-refresh.env

[Service]
Type=oneshot
User=obsidian-ai-reader
Group=obsidian-ai-reader
ExecStart=/opt/obsidian-ai/venv/bin/obsidian-semantic-refresh finalize \
  --ai-root /var/lib/obsidian-ai/state \
  --vault-root /var/lib/obsidian-ai/vault
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/obsidian-ai/vault
ReadWritePaths=/var/lib/obsidian-ai/state/04-Index /var/lib/obsidian-ai/state/24-Locks/read-view
UMask=0007
TimeoutStartSec=5min
