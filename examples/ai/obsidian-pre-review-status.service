[Unit]
Description=Project Obsidian pre-review aggregate status
Requires=obsidian-pre-review-evaluator.service obsidian-ai-post-review-reconcile.service
After=obsidian-pre-review-evaluator.service obsidian-ai-human-projection-sync.service obsidian-ai-post-review-reconcile.service

[Service]
Type=oneshot
User=obsidian-ai-status
Group=obsidian-ai-status
ExecStart=/opt/obsidian-ai/venv/bin/obsidian-pre-review-status-project \
  --ai-root /var/lib/obsidian-ai/state \
  --output /var/lib/obsidian-ai/state/02-Orchestration/status/pre-review-status.json
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/obsidian-ai/state/02-Orchestration/pre-review-jobs.sqlite3
ReadWritePaths=/var/lib/obsidian-ai/state/02-Orchestration/status
UMask=0027
TimeoutStartSec=1min
