[Unit]
Description=Obsidian GitHub Project watcher and proposal enqueue
Requires=obsidian-github-sync-vault-pull.service
After=network-online.target obsidian-github-sync-vault-pull.service
Wants=network-online.target

[Service]
Type=oneshot
User=obsidian-github-sync
Group=obsidian-github-sync
SupplementaryGroups=obsidian-github-vault obsidian-github-pipeline
UMask=0027
EnvironmentFile=-/etc/obsidian-github-sync/credentials.env
ExecStart=/opt/obsidian-github-sync/venv/bin/obsidian-github-project-watch-enqueue \
  --config /etc/obsidian-github-sync/config.toml \
  --request-dir /var/lib/obsidian-github-pipeline/25-Execution
ExecStart=/opt/obsidian-github-sync/venv/bin/obsidian-github-project-overview-enqueue \
  --config /etc/obsidian-github-sync/config.toml \
  --request-dir /var/lib/obsidian-github-pipeline/25-Execution
WorkingDirectory=/opt/obsidian-github-sync/app
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadOnlyPaths=/srv/obsidian-github-sync/vault /etc/obsidian-github-sync
ReadWritePaths=/var/lib/obsidian-github-sync /var/lib/obsidian-github-pipeline/25-Execution
InaccessiblePaths=/etc/obsidian-github-mirror /etc/obsidian-github-writer /var/lib/obsidian-github-pipeline/27-Transport

[Install]
WantedBy=multi-user.target
